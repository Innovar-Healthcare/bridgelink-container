# Copy OUTSIDE the repository (for example ~/.config/bl-eks-e2e.env) and fill in. It holds network
# and address details that do not belong in a public repo. Every script takes its path as the first
# argument. Every value is required; there are no defaults, region included, so nothing runs against
# a region or account by accident.

# AWS
PROFILE=                 # AWS CLI profile with a live session
REGION=                  # e.g. a development region; never a production one
VPC_ID=                  # existing VPC to build in
VPC_CIDR=                # its CIDR; the NLB accepts MLLP from here
AZ_A=                    # zone for the two-node group, e.g. us-east-1c
SUBNET_A=                # existing subnet in AZ_A
AZ_B=                    # zone for the one-node group
SUBNET_B=                # existing subnet in AZ_B
OPERATOR_PUBLIC_CIDR=    # x.x.x.x/32 of the machine running eksctl (public endpoint, creation only)
OPERATOR_PRIVATE_CIDR=   # the address your traffic reaches the VPC from (VPN), for the private endpoint
EBS_KMS_KEY_ARN=         # key ARN for node and claim volumes; the AWS-managed one is
                         # aws kms describe-key --key-id alias/aws/ebs --query KeyMetadata.Arn

# Tags on everything created
OWNER=
TICKET=
PROJECT=bl-eks-e2e

# Cluster and chart
CLUSTER_NAME=bl-eks-e2e
K8S_VERSION=             # an EKS version in standard support
RDS_STACK=bl-eks-e2e-rds
LBC_CHART_VERSION=       # eks/aws-load-balancer-controller chart version, pinned
CHART_VERSION=           # published BridgeLink chart version under test
OUT_DIR=                 # rendered files and kubeconfig, outside the repo, e.g. ~/.cache/bl-eks-e2e

# Optional: also send MLLP from this machine through the NLB (over the VPN). Set to the address
# that traffic arrives from inside the VPC as, e.g. the VPN's /32.
SENDER_CIDR=
