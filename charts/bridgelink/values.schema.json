{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "bridgelink": {
      "additionalProperties": false,
      "description": "BridgeLink Helm chart configuration @section Global Settings",
      "properties": {
        "affinity": {
          "default": "`{}`",
          "description": "Affinity for pod assignment",
          "required": [],
          "title": "affinity",
          "type": "object"
        },
        "environment": {
          "additionalProperties": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "default": "See below",
          "description": "Environment variables for BridgeLink configuration",
          "properties": {
            "MP_CONFIGURATIONMAP_LOCATION": {
              "default": "database",
              "description": "Configuration map storage location",
              "required": [],
              "title": "MP_CONFIGURATIONMAP_LOCATION"
            },
            "MP_DATABASE": {
              "default": "postgres",
              "description": "Database type to use (postgres, mysql, oracle, sqlserver)",
              "required": [],
              "title": "MP_DATABASE"
            },
            "MP_DATABASE_PASSWORD": {
              "default": "",
              "description": "Database password. Leave empty to use postgres.credentials.password with the bundled PostgreSQL",
              "required": [],
              "title": "MP_DATABASE_PASSWORD"
            },
            "MP_DATABASE_URL": {
              "default": "",
              "description": "JDBC URL of the database, passed through unchanged (a value containing {{ is rendered as a Helm template). Leave empty to use the bundled PostgreSQL; required when postgres.enabled is false. For embedded Derby set MP_DATABASE to derby and postgres.enabled to false, and leave this empty",
              "required": [],
              "title": "MP_DATABASE_URL"
            },
            "MP_DATABASE_USERNAME": {
              "default": "",
              "description": "Database username. Leave empty to use postgres.credentials.username with the bundled PostgreSQL",
              "required": [],
              "title": "MP_DATABASE_USERNAME"
            },
            "MP_KEYSTORE_KEYPASS": {
              "default": "bridgelinkKeystore",
              "description": "Keystore key password for TLS",
              "required": [],
              "title": "MP_KEYSTORE_KEYPASS"
            },
            "MP_KEYSTORE_STOREPASS": {
              "default": "bridgelinkKeypass",
              "description": "Keystore store password for TLS",
              "required": [],
              "title": "MP_KEYSTORE_STOREPASS"
            },
            "SERVER_ID": {
              "default": "",
              "description": "Server ID. Required on a new install; licenses are issued against it",
              "required": [],
              "title": "SERVER_ID"
            }
          },
          "required": [],
          "title": "environment"
        },
        "image": {
          "additionalProperties": false,
          "properties": {
            "pullPolicy": {
              "default": "`IfNotPresent`",
              "description": "Image pull policy",
              "required": [],
              "title": "pullPolicy"
            },
            "repository": {
              "default": "`innovarhealthcare/bridgelink`",
              "description": "BridgeLink container image repository",
              "required": [],
              "title": "repository"
            },
            "tag": {
              "default": "Chart appVersion",
              "description": "BridgeLink container image tag",
              "required": [],
              "title": "tag"
            }
          },
          "required": [],
          "title": "image",
          "type": "object"
        },
        "nodeSelector": {
          "default": "`{}`",
          "description": "Node labels for pod assignment",
          "required": [],
          "title": "nodeSelector",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "replicaCount": {
          "default": "1",
          "description": "Number of BridgeLink pods to run: 0 or 1. This chart runs one pod; a BridgeLink cluster runs several servers that share one server ID and use the Channel Coordinator plugin",
          "maximum": 1,
          "minimum": 0,
          "required": [],
          "title": "replicaCount",
          "type": "integer"
        },
        "runAsUser": {
          "default": 1000,
          "description": "Non-root UID the container runs as (1000 for Rocky image, 65532 for hardened DHI image)",
          "required": [],
          "title": "runAsUser"
        },
        "runAsGroup": {
          "default": 1000,
          "description": "Non-root GID the container runs as (1000 for Rocky image, 65532 for hardened DHI image)",
          "required": [],
          "title": "runAsGroup"
        },
        "resources": {
          "additionalProperties": false,
          "default": "See below",
          "description": "Resource limits and requests for the BridgeLink container",
          "properties": {
            "limits": {
              "properties": {
                "cpu": {
                  "default": "2000m",
                  "description": "CPU limit for BridgeLink container",
                  "required": [],
                  "title": "cpu"
                },
                "memory": {
                  "default": "2Gi",
                  "description": "Memory limit for BridgeLink container",
                  "required": [],
                  "title": "memory"
                }
              },
              "required": [],
              "title": "limits",
              "type": "object"
            },
            "requests": {
              "properties": {
                "cpu": {
                  "default": "500m",
                  "description": "CPU request for BridgeLink container",
                  "required": [],
                  "title": "cpu"
                },
                "memory": {
                  "default": "1Gi",
                  "description": "Memory request for BridgeLink container",
                  "required": [],
                  "title": "memory"
                }
              },
              "required": [],
              "title": "requests",
              "type": "object"
            }
          },
          "required": [
            "requests",
            "limits"
          ],
          "title": "resources"
        },
        "service": {
          "additionalProperties": false,
          "properties": {
            "ports": {
              "additionalProperties": false,
              "properties": {
                "http": {
                  "default": "8080",
                  "description": "HTTP Service port for BridgeLink; null leaves HTTP off the Service",
                  "required": [],
                  "title": "http",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 65535
                },
                "https": {
                  "default": "8443",
                  "description": "HTTPS port for BridgeLink secure web interface",
                  "required": [],
                  "title": "https",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [],
              "title": "ports",
              "type": "object"
            },
            "type": {
              "default": "`ClusterIP`",
              "description": "Kubernetes Service type for BridgeLink",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ],
              "required": [],
              "title": "type"
            },
            "annotations": {
              "additionalProperties": {
                "type": "string"
              },
              "default": "`{}`",
              "description": "Annotations for the BridgeLink Service",
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "loadBalancerSourceRanges": {
              "default": "`[]`",
              "description": "Client CIDRs allowed to reach the load balancer; used only when type is LoadBalancer",
              "items": {
                "type": "string"
              },
              "required": [],
              "title": "loadBalancerSourceRanges",
              "type": "array"
            },
            "loadBalancerClass": {
              "default": "\"\"",
              "description": "Load balancer class; used only when type is LoadBalancer",
              "required": [],
              "title": "loadBalancerClass",
              "type": "string"
            }
          },
          "required": [
            "ports"
          ],
          "title": "service",
          "type": "object"
        },
        "tolerations": {
          "default": "`[]`",
          "description": "Tolerations for pod assignment",
          "items": {
            "required": []
          },
          "required": [],
          "title": "tolerations"
        },
        "startupProbe": {
          "description": "Startup probe for the BridgeLink container. Gates readiness/liveness until the first boot completes. Set to null to disable.",
          "required": [],
          "title": "startupProbe",
          "type": [
            "object",
            "null"
          ]
        },
        "readinessProbe": {
          "description": "Readiness probe for the BridgeLink container. Parses /api/server/status, since that endpoint returns HTTP 200 even when the engine is unavailable. Set to null to disable.",
          "required": [],
          "title": "readinessProbe",
          "type": [
            "object",
            "null"
          ]
        },
        "livenessProbe": {
          "description": "Liveness probe for the BridgeLink container. A cheap HTTP 200 check only, so a transient database outage does not restart the pod. Set to null to disable.",
          "required": [],
          "title": "livenessProbe",
          "type": [
            "object",
            "null"
          ]
        },
        "containerSecurityContext": {
          "description": "Security context for the BridgeLink container and the keystore init container",
          "required": [],
          "title": "containerSecurityContext",
          "type": [
            "object",
            "null"
          ]
        },
        "helperImage": {
          "additionalProperties": false,
          "description": "Image for the init container that copies the keystore from keystore.existingSecret",
          "properties": {
            "pullPolicy": {
              "default": "IfNotPresent",
              "description": "Helper image pull policy",
              "required": [],
              "title": "pullPolicy",
              "type": "string"
            },
            "repository": {
              "default": "busybox",
              "description": "Helper image repository",
              "required": [],
              "title": "repository",
              "type": "string"
            },
            "tag": {
              "default": "1.37.0",
              "description": "Helper image tag, pinned",
              "minLength": 1,
              "required": [],
              "title": "tag",
              "type": "string"
            }
          },
          "required": [],
          "title": "helperImage",
          "type": "object"
        },
        "credentials": {
          "additionalProperties": false,
          "description": "Passwords from a Secret of your own",
          "properties": {
            "existingSecret": {
              "default": "",
              "description": "Secret holding the database and keystore passwords; the chart then stores none of them",
              "required": [],
              "title": "existingSecret",
              "type": "string"
            },
            "keys": {
              "additionalProperties": false,
              "description": "Key names in existingSecret; an empty name leaves that password to the chart",
              "properties": {
                "databasePassword": {
                  "default": "database.password",
                  "description": "Key holding the database password",
                  "required": [],
                  "title": "databasePassword",
                  "type": "string"
                },
                "keystoreStorepass": {
                  "default": "keystore.storepass",
                  "description": "Key holding the keystore store password",
                  "required": [],
                  "title": "keystoreStorepass",
                  "type": "string"
                },
                "keystoreKeypass": {
                  "default": "keystore.keypass",
                  "description": "Key holding the keystore key password",
                  "required": [],
                  "title": "keystoreKeypass",
                  "type": "string"
                }
              },
              "required": [],
              "title": "keys",
              "type": "object"
            }
          },
          "required": [],
          "title": "credentials",
          "type": "object"
        },
        "keystore": {
          "additionalProperties": false,
          "description": "A keystore supplied from a Secret",
          "properties": {
            "existingSecret": {
              "default": "",
              "description": "Secret holding keystore.jks, keystore.storepass and keystore.keypass, copied into appdata at every start",
              "required": [],
              "title": "existingSecret",
              "type": "string"
            }
          },
          "required": [],
          "title": "keystore",
          "type": "object"
        },
        "persistence": {
          "additionalProperties": false,
          "description": "Where appdata, which holds the keystore and data-encryption key, is kept",
          "properties": {
            "accessModes": {
              "default": [
                "ReadWriteOnce"
              ],
              "description": "Access modes for the claim",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "required": [],
              "title": "accessModes",
              "type": "array"
            },
            "enabled": {
              "default": true,
              "description": "Keep appdata on a PersistentVolumeClaim. false uses an emptyDir.",
              "required": [],
              "title": "enabled",
              "type": "boolean"
            },
            "existingClaim": {
              "default": "",
              "description": "Existing PersistentVolumeClaim to use instead of creating one",
              "required": [],
              "title": "existingClaim",
              "type": "string"
            },
            "size": {
              "default": "1Gi",
              "description": "Size of the claim",
              "required": [],
              "title": "size",
              "type": "string"
            },
            "storageClass": {
              "default": "",
              "description": "Storage class for the claim. Empty uses the cluster default.",
              "required": [],
              "title": "storageClass",
              "type": "string"
            }
          },
          "required": [],
          "title": "persistence",
          "type": "object"
        },
        "podSecurityContext": {
          "description": "Pod security context. runAsUser, runAsGroup and fsGroup default to bridgelink.runAsUser and bridgelink.runAsGroup.",
          "required": [],
          "title": "podSecurityContext",
          "type": [
            "object",
            "null"
          ]
        },
        "podAnnotations": {
          "additionalProperties": {
            "type": "string"
          },
          "default": "`{}`",
          "description": "Extra annotations for the BridgeLink pod",
          "required": [],
          "title": "podAnnotations",
          "type": "object"
        },
        "podLabels": {
          "additionalProperties": {
            "type": "string"
          },
          "default": "`{}`",
          "description": "Extra labels for the BridgeLink pod",
          "required": [],
          "title": "podLabels",
          "type": "object"
        },
        "extraEnv": {
          "default": "`[]`",
          "description": "Extra EnvVar entries for the BridgeLink container; they replace chart-set variables of the same name",
          "items": {
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "required": [],
          "title": "extraEnv",
          "type": "array"
        },
        "extraVolumes": {
          "default": "`[]`",
          "description": "Extra volumes for the BridgeLink pod",
          "items": {
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "required": [],
          "title": "extraVolumes",
          "type": "array"
        },
        "extraVolumeMounts": {
          "default": "`[]`",
          "description": "Extra volume mounts for the BridgeLink container",
          "items": {
            "properties": {
              "name": {
                "type": "string"
              },
              "mountPath": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "mountPath"
            ],
            "type": "object"
          },
          "required": [],
          "title": "extraVolumeMounts",
          "type": "array"
        },
        "extraPorts": {
          "default": "`[]`",
          "description": "Extra container and Service ports for channel listeners",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "Port name: lowercase letters, digits and hyphens, at most 15 characters",
                "maxLength": 15,
                "not": {
                  "enum": [
                    "http",
                    "https"
                  ]
                },
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "type": "string"
              },
              "containerPort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Port the channel listens on"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Service port; defaults to containerPort"
              },
              "protocol": {
                "enum": [
                  "TCP",
                  "UDP",
                  "SCTP"
                ],
                "type": "string"
              }
            },
            "required": [
              "name",
              "containerPort"
            ],
            "type": "object"
          },
          "required": [],
          "title": "extraPorts",
          "type": "array"
        },
        "listenerService": {
          "additionalProperties": false,
          "description": "Separate Service carrying only extraPorts",
          "properties": {
            "enabled": {
              "default": "false",
              "description": "Create the listener Service and move extraPorts onto it",
              "required": [],
              "title": "enabled",
              "type": "boolean"
            },
            "type": {
              "default": "`ClusterIP`",
              "description": "Kubernetes Service type for the listener Service",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ],
              "required": [],
              "title": "type"
            },
            "annotations": {
              "additionalProperties": {
                "type": "string"
              },
              "default": "`{}`",
              "description": "Annotations for the listener Service",
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "loadBalancerSourceRanges": {
              "default": "`[]`",
              "description": "Client CIDRs allowed to reach the load balancer; used only when type is LoadBalancer",
              "items": {
                "type": "string"
              },
              "required": [],
              "title": "loadBalancerSourceRanges",
              "type": "array"
            },
            "loadBalancerClass": {
              "default": "\"\"",
              "description": "Load balancer class; used only when type is LoadBalancer",
              "required": [],
              "title": "loadBalancerClass",
              "type": "string"
            }
          },
          "required": [],
          "title": "listenerService",
          "type": "object"
        }
      },
      "required": [
        "image",
        "service"
      ],
      "title": "bridgelink"
    },
    "fullnameOverride": {
      "default": "",
      "description": "Provide a name to substitute for the full names of resources",
      "required": [],
      "title": "fullnameOverride"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "nameOverride": {
      "default": "",
      "description": "Override the name of the chart",
      "required": [],
      "title": "nameOverride"
    },
    "postgres": {
      "additionalProperties": false,
      "properties": {
        "credentials": {
          "additionalProperties": false,
          "description": "PostgreSQL database credentials",
          "properties": {
            "database": {
              "default": "bridgelinkdb",
              "description": "PostgreSQL database name",
              "required": [],
              "title": "database"
            },
            "password": {
              "default": "bridgelinktest",
              "description": "PostgreSQL password",
              "required": [],
              "title": "password"
            },
            "username": {
              "default": "bridgelinktest",
              "description": "PostgreSQL username",
              "required": [],
              "title": "username"
            }
          },
          "required": [],
          "title": "credentials"
        },
        "enabled": {
          "default": "true",
          "description": "Deploy a bundled PostgreSQL for evaluation only (single pod, no backups). Set to false and use an external database such as Amazon RDS for production",
          "required": [],
          "title": "enabled"
        },
        "image": {
          "additionalProperties": false,
          "properties": {
            "pullPolicy": {
              "default": "IfNotPresent",
              "description": "PostgreSQL image pull policy",
              "required": [],
              "title": "pullPolicy"
            },
            "repository": {
              "default": "postgres",
              "description": "PostgreSQL container image repository",
              "required": [],
              "title": "repository"
            },
            "tag": {
              "default": "16-alpine",
              "description": "PostgreSQL container image tag",
              "required": [],
              "title": "tag"
            }
          },
          "required": [],
          "title": "image",
          "type": "object"
        },
        "persistence": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": "true",
              "description": "Enable persistent storage for PostgreSQL data",
              "required": [],
              "title": "enabled"
            },
            "size": {
              "default": "10Gi",
              "description": "Size of the persistent volume claim",
              "required": [],
              "title": "size"
            },
            "storageClass": {
              "default": "\"\" (use default storage class)",
              "description": "Storage class for PostgreSQL PVC",
              "required": [],
              "title": "storageClass"
            }
          },
          "required": [],
          "title": "persistence",
          "type": "object"
        },
        "resources": {
          "additionalProperties": false,
          "description": "Resource limits and requests for PostgreSQL container",
          "properties": {
            "limits": {
              "properties": {
                "cpu": {
                  "default": "1000m",
                  "description": "CPU limit for PostgreSQL container",
                  "required": [],
                  "title": "cpu"
                },
                "memory": {
                  "default": "1Gi",
                  "description": "Memory limit for PostgreSQL container",
                  "required": [],
                  "title": "memory"
                }
              },
              "required": [],
              "title": "limits",
              "type": "object"
            },
            "requests": {
              "properties": {
                "cpu": {
                  "default": "200m",
                  "description": "CPU request for PostgreSQL container",
                  "required": [],
                  "title": "cpu"
                },
                "memory": {
                  "default": "256Mi",
                  "description": "Memory request for PostgreSQL container",
                  "required": [],
                  "title": "memory"
                }
              },
              "required": [],
              "title": "requests",
              "type": "object"
            }
          },
          "required": [
            "requests",
            "limits"
          ],
          "title": "resources"
        },
        "service": {
          "additionalProperties": false,
          "properties": {
            "port": {
              "default": "5432",
              "description": "PostgreSQL service port number",
              "required": [],
              "title": "port"
            }
          },
          "required": [],
          "title": "service",
          "type": "object"
        }
      },
      "required": [
        "image",
        "service",
        "persistence"
      ],
      "title": "postgres",
      "type": "object"
    },
    "webadmin": {
      "additionalProperties": false,
      "description": "Optional WebAdmin deployment",
      "properties": {
        "acceptLicense": {
          "default": false,
          "description": "Accept the WebAdmin license (BSL 1.1 plus the BridgeLink WebAdmin Supplemental Terms). Required when enabled is true; the chart never accepts it for you.",
          "required": [],
          "title": "acceptLicense",
          "type": "boolean"
        },
        "affinity": {
          "default": "`{}`",
          "description": "Affinity rules for WebAdmin pod assignment",
          "required": [],
          "title": "affinity",
          "type": "object"
        },
        "containerPort": {
          "default": 8444,
          "description": "Port WebAdmin listens on (HTTPS), passed to the container as PORT",
          "required": [],
          "title": "containerPort",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "description": "Deploy WebAdmin alongside BridgeLink, pointed at this release's BridgeLink Service",
          "required": [],
          "title": "enabled",
          "type": "boolean"
        },
        "env": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "default": "`{}`",
          "description": "Extra environment variables for WebAdmin",
          "required": [],
          "title": "env",
          "type": "object"
        },
        "image": {
          "additionalProperties": false,
          "properties": {
            "pullPolicy": {
              "default": "IfNotPresent",
              "description": "WebAdmin image pull policy",
              "required": [],
              "title": "pullPolicy"
            },
            "repository": {
              "default": "innovarhealthcare/bridgelink-webadmin",
              "description": "WebAdmin container image repository",
              "required": [],
              "title": "repository"
            },
            "tag": {
              "default": "26.9.0",
              "description": "WebAdmin container image tag",
              "required": [],
              "title": "tag"
            }
          },
          "required": [],
          "title": "image",
          "type": "object"
        },
        "livenessProbe": {
          "description": "Liveness probe for the WebAdmin container. Set to null to disable.",
          "required": [],
          "title": "livenessProbe",
          "type": [
            "object",
            "null"
          ]
        },
        "nodeSelector": {
          "default": "`{}`",
          "description": "Node labels for WebAdmin pod assignment",
          "required": [],
          "title": "nodeSelector",
          "type": "object"
        },
        "readinessProbe": {
          "description": "Readiness probe for the WebAdmin container. Set to null to disable.",
          "required": [],
          "title": "readinessProbe",
          "type": [
            "object",
            "null"
          ]
        },
        "resources": {
          "description": "Resource limits and requests for the WebAdmin container",
          "required": [],
          "title": "resources",
          "type": "object"
        },
        "service": {
